<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only export of ReminderReceiver so `adb shell am broadcast` can
     reproduce a reminder fire without waiting for the alarm. Release keeps
     android:exported="false" from the main manifest. The health-diary receivers
     get the same treatment: a dose reminder is otherwise only testable by
     waiting for the clock. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <receiver
            android:name="app.chompass.services.ReminderReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <receiver
            android:name="app.chompass.health.reminder.HealthReminderReceiver"
            android:exported="true"
            tools:replace="android:exported" />

        <receiver
            android:name="app.chompass.health.reminder.HealthBootReceiver"
            android:exported="true"
            tools:replace="android:exported" />
    </application>
</manifest>
